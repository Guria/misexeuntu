[Unit]
Description=Run exeuntu-materialize periodically

[Timer]
# Short cadence on purpose: the boot-time run races the network (a skip exits
# zero by design), so pickup must not depend on catching the window — each
# later run is a cheap marker check plus one reflection GET.
OnBootSec=45s
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
