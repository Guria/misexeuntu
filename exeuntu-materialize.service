[Unit]
Description=Materialize dotfiles discovered via exe.dev reflection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=exedev
Group=exedev
WorkingDirectory=/home/exedev
Environment=HOME=/home/exedev
Environment=USER=exedev
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# Deterministic pickup: the boot run blocks until reflection answers (or ~5
# minutes pass), so materialization fires the moment the network is up
# instead of racing it at OnBootSec. Always exits 0 — unreachability stays a
# graceful skip for the ExecStart that follows.
ExecStartPre=/bin/sh -c 'i=0; until curl -fsS --max-time 3 https://reflection.int.exe.xyz/ >/dev/null 2>&1 || [ $i -ge 150 ]; do i=$((i+1)); sleep 2; done; exit 0'
ExecStart=/usr/local/bin/exeuntu materialize
# A first converge installs toolchains through mise; give it room instead of
# letting the default 90s oneshot timeout kill it mid-install.
TimeoutStartSec=45min
StandardOutput=journal
StandardError=journal
SyslogIdentifier=exeuntu-materialize

[Install]
# Start at boot, not via the timer: a timer's default AccuracySec coalesces
# wakeups into a 1-minute window, which delayed first convergence by ~1 min
# on an 0.8s boot. ExecStartPre already blocks until reflection answers.
WantedBy=multi-user.target
